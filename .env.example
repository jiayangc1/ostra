# ---- API (apps/api) ----
PORT=8787
PUBLIC_API_URL=http://localhost:8787
APP_URL=http://localhost:5173

# Postgres. Unset = embedded PGlite under .data/ (development).
DATABASE_URL=
# Redis for BullMQ + realtime fan-out. Unset = in-process queue.
REDIS_URL=

# Envelope encryption master key(s): base64 32 bytes, or "1:key,2:key" for rotation.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Unset in development = a key file under .data/.
OSTRA_MASTER_KEY=

# Clerk. Unset = development sign-in (refused in production).
# `npx clerk env pull --file .env.local` fills CLERK_PUBLISHABLE_KEY and CLERK_SECRET_KEY.
# .env.local overrides .env; both are read by the API and the web app.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,tauri://localhost,http://tauri.localhost

# S3-compatible object storage for encrypted bodies/attachments. Unset = .data/blobs.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Gmail and Google Calendar (Google Cloud OAuth client + Pub/Sub topic for push)
# Redirect URIs to register: <PUBLIC_API_URL>/oauth/gmail/callback and <PUBLIC_API_URL>/oauth/calendar/google/callback
# Enable the Gmail API and the Google Calendar API on the project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_AUDIENCE=

# Outlook mail and calendar (Microsoft Entra app registration)
# Redirect URIs to register: <PUBLIC_API_URL>/oauth/outlook/callback and <PUBLIC_API_URL>/oauth/calendar/microsoft/callback
# Delegated permission to add: Calendars.ReadWrite
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# AI (Anthropic). Unset = heuristics only, writing features disabled.
ANTHROPIC_API_KEY=

# false = run `pnpm --filter @ostra/api worker` separately (requires REDIS_URL)
OSTRA_INLINE_WORKERS=true

# ---- Web (apps/web) ----
# Optional; CLERK_PUBLISHABLE_KEY above is used when this is empty.
VITE_CLERK_PUBLISHABLE_KEY=
ALLOW_PRIVATE_MAIL_HOSTS=false
# OSTRA_DEMO=true seeds demo accounts (POST /api/dev/seed); never honored in production.
OSTRA_DEMO=false
