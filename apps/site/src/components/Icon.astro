interface Props {
  name: keyof typeof PATHS;
  size?: number;
  class?: string;
  strokeWidth?: number;
}
const { name, size = 16, class: className, strokeWidth = 1.75 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
  set:html={PATHS[name]}
/>
