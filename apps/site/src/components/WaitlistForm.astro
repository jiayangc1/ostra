---
import { SITE } from "../config.ts";

interface Props {
  id: string;
  class?: string;
}
const { id, class: className } = Astro.props;
---

<form data-waitlist data-api={SITE.apiUrl} novalidate class:list={["w-full max-w-[420px]", className]}>
  <div class="flex items-center gap-1 rounded-[10px] border border-line bg-panel p-1 transition-[border-color,box-shadow] duration-200 focus-within:border-line-strong focus-within:shadow-[0_0_0_4px_color-mix(in_srgb,var(--o-focus)_18%,transparent)] hover:border-line-hover">
    <label for={id} class="sr-only">Email address</label>
    <input
      id={id}
      name="email"
      type="email"
      required
      autocomplete="email"
      placeholder="you@company.com"
      aria-describedby={`${id}-status`}
      class="h-9 min-w-0 flex-1 bg-transparent px-3 text-sm text-fg outline-none placeholder:text-fg-3 focus-visible:outline-none"
    />
    <button type="submit" class="o-press h-9 shrink-0 rounded-[7px] bg-primary px-4 text-sm font-medium text-primary-fg hover:bg-primary-hover disabled:opacity-60">Join the waitlist</button>
  </div>
  <p id={`${id}-status`} role="status" aria-live="polite" class="mt-3 flex min-h-5 items-center justify-center gap-1.5 text-[13px] text-fg-3 data-[state=error]:text-red data-[state=ok]:text-green"></p>
</form>
