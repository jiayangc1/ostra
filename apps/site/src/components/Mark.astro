---
/** The converge mark, inline so it follows the theme's foreground color. */
interface Props {
  size?: number;
  class?: string;
}
const { size = 24, class: className } = Astro.props;
---

<svg viewBox="0 0 44 44" width={size} height={size} fill="none" aria-hidden="true" class={className}>
  <path d="M6 8 C20 8 20 22 30 22 M6 22 L30 22 M6 36 C20 36 20 22 30 22" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"></path>
  <circle cx="35" cy="22" r="4" fill="currentColor"></circle>
</svg>
