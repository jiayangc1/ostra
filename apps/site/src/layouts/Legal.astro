---
import Layout from "./Layout.astro";
import Mark from "../components/Mark.astro";
import Wordmark from "../components/Wordmark.astro";

interface Props {
  title: string;
  description: string;
  updated: string;
}
const { title, description, updated } = Astro.props;
---

<Layout title={`${title} · Ostra`} description={description}>
  <header class="border-b border-line">
    <div class="mx-auto flex h-14 max-w-3xl items-center px-4 sm:px-6">
      <a href="/" class="flex items-center gap-2 text-fg" aria-label="Ostra home">
        <Mark size={18} />
        <Wordmark height={12} />
      </a>
    </div>
  </header>
  <main class="legal mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
    <h1 class="text-3xl tracking-[-0.03em]">{title}</h1>
    <p class="mt-2 text-[13px] text-fg-3">Last updated {updated}</p>
    <div class="mt-10 space-y-4 text-[15px] leading-7 text-fg-2">
      <slot />
    </div>
  </main>
  <footer class="border-t border-line">
    <div class="mx-auto flex max-w-3xl flex-wrap gap-x-6 gap-y-2 px-4 py-8 text-[13px] text-fg-3 sm:px-6">
      <a href="/" class="hover:text-fg">Home</a>
      <a href="/privacy" class="hover:text-fg">Privacy</a>
      <a href="/terms" class="hover:text-fg">Terms</a>
    </div>
  </footer>
</Layout>

<style>
  .legal :global(h2) {
    margin-top: 2.5rem;
    font-size: 1.125rem;
    color: var(--color-fg);
    letter-spacing: -0.01em;
  }
  .legal :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .legal :global(li + li) {
    margin-top: 0.375rem;
  }
  .legal :global(a) {
    color: var(--color-fg);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
