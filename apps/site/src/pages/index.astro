---
import Layout from "../layouts/Layout.astro";
import Mark from "../components/Mark.astro";
import Wordmark from "../components/Wordmark.astro";
import HeroStage from "../components/HeroStage.astro";
import Features from "../components/Features.astro";
import WaitlistForm from "../components/WaitlistForm.astro";
import { SITE } from "../config.ts";

const privacy = [
  { title: "Encrypted at rest", body: "Passwords, tokens and message bodies are encrypted, each with its own key." },
  { title: "AI is a switch", body: "Turn it off for everything, for one account or for one label. Off means no mail reaches a model." },
  { title: "In sync both ways", body: "Archive in Ostra and it's archived in Gmail too. Ostra never changes your mailbox without you." },
];

const desktop = [
  { name: "macOS", url: SITE.downloads.mac },
  { name: "Windows", url: SITE.downloads.windows },
  { name: "Linux", url: SITE.downloads.linux },
];
const year = new Date().getFullYear();
---

<Layout title="Ostra: every inbox, one place" description="Ostra merges every email account you own into one fast, keyboard-first inbox, and keeps mail from real people above the noise.">
  <header data-nav class="site-nav fixed inset-x-0 top-0 z-30">
    <nav class="mx-auto flex h-14 max-w-[1080px] items-center justify-between px-4 sm:px-6" aria-label="Main">
      <a href="/" class="flex items-center gap-2 rounded-control text-fg" aria-label="Ostra home">
        <Mark size={22} />
        <Wordmark height={14} />
      </a>
      <div class="flex items-center gap-1 text-[13px]">
        <a href="#features" class="hidden rounded-control px-3 py-1.5 text-fg-2 transition-colors hover:text-fg sm:inline">Features</a>
        <a href="#privacy" class="hidden rounded-control px-3 py-1.5 text-fg-2 transition-colors hover:text-fg sm:inline">Privacy</a>
        <a href={SITE.appUrl} class="rounded-control px-3 py-1.5 text-fg-2 transition-colors hover:text-fg">Sign in</a>
        <a href="#join" class="o-press ml-1 rounded-control bg-primary px-3 py-1.5 font-medium text-primary-fg hover:bg-primary-hover">Join the waitlist</a>
      </div>
    </nav>
  </header>

  <main>
    <section class="relative">
      <div class="hero-glow pointer-events-none absolute inset-x-0 top-0 h-[640px]" aria-hidden="true"></div>
      <div class="relative mx-auto flex max-w-[1080px] flex-col items-center px-4 pt-28 text-center sm:px-6 lg:pt-32">
        <h1 class="text-[46px] font-semibold leading-[1.02] tracking-[-0.05em] sm:text-[64px] lg:text-[76px]">
          <span data-enter class="block" style="--d: 0">Every inbox.</span>
          <span data-enter class="block" style="--d: 110">One place.</span>
        </h1>
        <p data-enter style="--d: 240" class="mt-6 max-w-[34rem] text-[17px] leading-relaxed text-fg-2 sm:text-lg">
          Ostra brings every address you own into one fast, keyboard-first inbox, and keeps mail from real people above the noise.
        </p>
        <div data-enter style="--d: 360" class="mt-9 flex w-full justify-center">
          <WaitlistForm id="hero-email" />
        </div>
        <p data-enter style="--d: 460" class="text-[12.5px] text-fg-3">Works with Gmail, Outlook, iCloud, Yahoo, any IMAP host and your own domain.</p>
      </div>
      <div class="mx-auto mt-16 max-w-[1080px] px-4 sm:px-6 lg:mt-20">
        <HeroStage />
      </div>
    </section>

    <section id="features" class="mx-auto max-w-[1080px] scroll-mt-20 px-4 pt-32 sm:px-6 lg:pt-44">
      <h2 data-reveal class="max-w-xl text-[32px] font-semibold leading-[1.1] tracking-[-0.035em] sm:text-[40px]">
        Fast enough to keep up.<br /><span class="text-fg-3">Smart enough to sort.</span>
      </h2>
      <div class="mt-14">
        <Features />
      </div>
    </section>

    <section id="privacy" class="mx-auto max-w-[1080px] scroll-mt-20 px-4 pt-32 sm:px-6 lg:pt-44">
      <h2 data-reveal class="max-w-xl text-[32px] font-semibold leading-[1.1] tracking-[-0.035em] sm:text-[40px]">
        Your mail stays yours.
      </h2>
      <div class="mt-12 grid gap-8 sm:grid-cols-3 sm:gap-6">
        {
          privacy.map((p, i) => (
            <div data-reveal style={`--d: ${i * 100}`} class="border-t border-line pt-5">
              <h3 class="text-[15px] font-medium tracking-[-0.01em] text-fg">{p.title}</h3>
              <p class="mt-1.5 text-[14.5px] leading-relaxed text-fg-2">{p.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section id="join" class="scroll-mt-10 px-4 pb-28 pt-36 sm:px-6 lg:pb-36 lg:pt-48">
      <div data-reveal class="mx-auto flex max-w-xl flex-col items-center text-center">
        <Mark size={44} draw class="text-fg" />
        <h2 class="mt-8 text-[32px] font-semibold leading-[1.1] tracking-[-0.035em] sm:text-[40px]">Find the pearls in your inbox.</h2>
        <p class="mt-4 max-w-md text-[16px] leading-relaxed text-fg-2">
          <span class="text-fg">Ostra</span> is Spanish and Portuguese for oyster. We're letting people in a few at a time.
        </p>
        <WaitlistForm id="join-email" class="mt-9" />
        <p class="text-[13px] text-fg-3">Free during the beta. Beta users keep a discount when Pro launches.</p>
        <p class="mt-10 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 font-mono text-[12px] text-fg-3">
          <a href={SITE.appUrl} class="text-fg-2 transition-colors hover:text-fg">Open in browser ↗</a>
          {desktop.map((d) => (d.url ? <a href={d.url} class="text-fg-2 transition-colors hover:text-fg">{d.name}</a> : <span>{d.name} soon</span>))}
        </p>
      </div>
    </section>
  </main>

  <footer class="border-t border-line">
    <div class="mx-auto flex max-w-[1080px] flex-col items-center justify-between gap-4 px-4 py-8 text-[13px] text-fg-3 sm:flex-row sm:px-6">
      <a href="/" class="flex items-center gap-2 text-fg-2" aria-label="Ostra home">
        <Mark size={16} />
        <Wordmark height={11} />
      </a>
      <nav class="flex items-center gap-5" aria-label="Legal">
        <span>© {year} Ostra</span>
        <a href="/privacy" class="transition-colors hover:text-fg">Privacy</a>
        <a href="/terms" class="transition-colors hover:text-fg">Terms</a>
      </nav>
    </div>
  </footer>

  <script>
    import "../scripts/landing.ts";
  </script>
</Layout>
