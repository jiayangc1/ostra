{
  "name": "@ostra/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "OSTRA_DEMO=${OSTRA_DEMO:-true} tsx watch --clear-screen=false src/main.ts",
    "start": "tsx src/main.ts",
    "worker": "tsx src/worker-main.ts",
    "seed": "tsx src/seed-cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "NODE_ENV=test node --import tsx --test --test-concurrency=1 \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@clerk/backend": "^3.26.4",
    "@hono/node-server": "^2.1.5",
    "@hono/node-ws": "^1.3.1",
    "@ostra/ai": "workspace:*",
    "@ostra/core": "workspace:*",
    "@ostra/db": "workspace:*",
    "@ostra/sync-gmail": "workspace:*",
    "@ostra/sync-imap": "workspace:*",
    "@ostra/sync-outlook": "workspace:*",
    "@ostra/sync-resend": "workspace:*",
    "bullmq": "^5.81.5",
    "hono": "^4.13.14",
    "ioredis": "^5.11.1",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.2.14",
    "zod": "^4.6.7"
  }
}
